{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fahed-jewelry",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Bind your D1 database in the Cloudflare dashboard (Workers → Settings → Bindings)
  // or fill in the database_id below after `wrangler d1 create fahed-jewelry`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fahed",
      "database_id": "c1b23eac-d63c-4139-b5d2-ffb46dda389d",
      "migrations_dir": "migrations"
    }
  ]
}
